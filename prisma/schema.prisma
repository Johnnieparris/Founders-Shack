// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String          @id @default(cuid())
    name          String?
    email         String?         @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    posts         Post[]
    profile       StudentProfile?
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// Onboarding flow uses this table via Supabase client (kept in schema so Prisma doesn't drop it)
model OnboardingUser {
    id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    createdAt  DateTime  @default(now()) @map("created_at")
    name       String
    country    String
    university String?
    degree     String?
    major      String?
    yearLevel  String?   @map("year_level")

    @@map("users")
}

// ─── Domain Models ───

enum EventCategory {
    INDUSTRY_PROGRAM
    NETWORKING
    CAREER_FAIR
    COMPANY_TALK
    SOCIAL
    WORKSHOP
    HACKATHON
}

enum EventSource {
    INSTAGRAM
    WEBSITE
    FACEBOOK
    EVENTBRITE
    MANUAL
    RUBRIC
    PWC
    ENGINEERS_AUSTRALIA
}

enum OpportunityType {
    SOCIETY_REC
    PROJECT_TEAM
    RESEARCH
    COMPANY
}

model StudentProfile {
    id                 String    @id @default(cuid())
    userId             String    @unique
    user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    degree             String
    year               Int
    startYear          Int
    expectedGradYear   Int
    interests          String[]
    followedSocieties  Society[] @relation("StudentSocieties")
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt
}

model Society {
    id              String           @id @default(cuid())
    name            String           @unique
    description     String?
    category        String?
    instagramHandle String?
    websiteUrl      String?
    facebookUrl     String?
    imageUrl        String?
    events          Event[]
    opportunities   Opportunity[]
    followers       StudentProfile[] @relation("StudentSocieties")
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
}

model Event {
    id          String        @id @default(cuid())
    name        String
    organiser   String
    description String?
    category    EventCategory
    date        DateTime
    endDate     DateTime?
    location    String?
    source      EventSource   @default(MANUAL)
    sourceUrl   String?
    aiSummary   String?
    imageUrl    String?
    societyId   String?
    society     Society?      @relation(fields: [societyId], references: [id])
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    @@index([category])
    @@index([date])
}

model Opportunity {
    id                  String          @id @default(cuid())
    name                String
    description         String?
    type                OpportunityType
    applicationDeadline DateTime?
    url                 String?
    sourceUrl           String?
    source              String?
    societyId           String?
    society             Society?        @relation(fields: [societyId], references: [id])
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt

    @@index([type])
    @@index([sourceUrl])
}
